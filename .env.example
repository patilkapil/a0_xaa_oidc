# ─── Okta (Client / IdP) ─────────────────────────────────────────
OKTA_DOMAIN=your-org.okta.com
OKTA_CLIENT_ID=your_okta_agent_client_id
OKTA_CLIENT_SECRET=your_okta_agent_client_secret
# The Okta Authorization Server audience (default: api://default, or custom)
OKTA_AUDIENCE=api://default

# ─── Auth0 (Resource Server) ──────────────────────────────────────
AUTH0_DOMAIN=your-tenant.auth0.com
# The Auth0 API identifier (Audience) you created in Auth0 Dashboard > APIs
AUTH0_API_AUDIENCE=https://your-api-identifier/
# The Auth0 application (Machine-to-Machine or Regular Web App) that will
# perform the token exchange on behalf of the agent
AUTH0_CLIENT_ID=your_auth0_app_client_id
AUTH0_CLIENT_SECRET=your_auth0_app_client_secret
# The Auth0 Enterprise connection name for your Okta IdP (Auth0 Dashboard > Authentication > Enterprise)
AUTH0_CONNECTION=your_auth0_enterprise_connection_name
# Space-separated scopes to request (e.g. "openid profile email read:data")
AUTH0_API_SCOPE=openid

# ─── Okta Resource Authorization Server ───────────────────────────
# Issuer URL of the Okta Resource App's AS (Security > API > Authorization Servers > Issuer)
OKTA_RESOURCE_AS_ISSUER=https://your-org.okta.com/oauth2/your-resource-as-id
